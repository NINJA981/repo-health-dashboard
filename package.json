{
  "name": "github-repo-health-dashboard",
  "version": "1.0.0",
  "description": "Full-stack GitHub Repository Health Analyzer and Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
